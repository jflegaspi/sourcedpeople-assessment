{%- if product -%}
  {% assign matched_lookbook_handles = "" %}
  {% assign lookbook_count = 0 %}

  {%- for lookbook in shop.metaobjects.lookbook.values -%}
    {%- assign has_product = false -%}
    
    {%- for lb_product in lookbook.products.value -%}
      {%- if lb_product.handle == product.handle -%}
        {%- assign has_product = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if has_product and lookbook_count < 2 -%}
      {%- assign matched_lookbook_handles = matched_lookbook_handles | append: lookbook.system.handle | append: ',' -%}
      {%- assign lookbook_count = lookbook_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if lookbook_count > 0 -%}
      <div class="react-lookbook-mount" 
          style="margin-top: {{ section.settings.margin_top }}px; margin-bottom: {{ section.settings.margin_bottom }}px;"
          data-lookbook-handles="{{ matched_lookbook_handles | remove_last: ',' }}"
          data-country="{{ localization.country.iso_code }}"
          data-columns="{{ section.settings.columns | default: 3 }}"
          data-title-size="{{ section.settings.title_size | default: '2.0' }}"
          data-show-description="{{ section.settings.show_description }}"
          data-description-size="{{ section.settings.description_size | default: '1.0' }}">
      </div>
  {%- elsif request.design_mode -%}
      <div style="padding: 40px 20px; text-align: center; border: 2px dashed #ccc; background: #f9f9f9; margin-top: {{ section.settings.margin_top }}px; margin-bottom: {{ section.settings.margin_bottom }}px;">
         <p style="margin: 0; font-weight: bold;">Lookbook (Product Page) Section</p>
         <p style="margin: 5px 0 0 0; color: #666;">Hidden because the current product is not assigned to any lookbooks.</p>
      </div>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Lookbook (Product Page)",
  "settings": [
    {
      "type": "header",
      "content": "Grid & Layout Settings"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Products per row",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Typography Settings"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Header Title Size (rem)",
      "min": 1.2,
      "max": 3.0,
      "step": 0.2,
      "default": 2.0
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": true
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description Font Size (rem)",
      "min": 0.8,
      "max": 1.5,
      "step": 0.1,
      "default": 1.0
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top margin",
      "default": 36
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom margin",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Lookbook (Product Page)"
    }
  ]
}
{% endschema %}